{
 "buildCommand": "node build-blog.js",
 "headers": [
  {
   "headers": [
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000; includeSubDomains"
    }
   ],
   "source": "/(.*)"
  }
 ],
 "outputDirectory": ".",
 "redirects": [
  {
   "destination": "/admin/",
   "permanent": false,
   "source": "/admin"
  },
  {
   "destination": "/tools.html",
   "permanent": false,
   "source": "/tools"
  },
  {
   "destination": "/blog.html",
   "permanent": false,
   "source": "/blog"
  },
  {
